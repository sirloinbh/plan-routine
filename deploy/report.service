# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Plan Routine daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/plan-routine
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/plan-routine/deploy/report.sh /tmp/plan-report.sh && exec /bin/bash /tmp/plan-report.sh'
TimeoutStartSec=5min
