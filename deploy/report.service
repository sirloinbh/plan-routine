# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=계획·실천·루틴·피드백 daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/plan-routine
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/plan-routine/deploy/report.sh /tmp/plan-report.sh && exec /bin/bash /tmp/plan-report.sh'
TimeoutStartSec=5min
