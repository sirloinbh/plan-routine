# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Plan Routine weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/plan-routine
ExecStart=/bin/bash -c 'cp /opt/plan-routine/deploy/backup.sh /tmp/plan-restore-check.sh && exec /bin/bash /tmp/plan-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
