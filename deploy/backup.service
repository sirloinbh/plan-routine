# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Plan Routine daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/plan-routine
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/plan-routine/deploy/backup.sh /tmp/plan-backup.sh && exec /bin/bash /tmp/plan-backup.sh dump'
TimeoutStartSec=30min
Nice=10
