# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Plan Routine health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/plan-routine
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/plan-routine/deploy/notify.sh /tmp/plan-notify.sh && exec /bin/bash /tmp/plan-notify.sh health'
TimeoutStartSec=2min
