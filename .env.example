POSTGRES_DB=plan
POSTGRES_USER=plan
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://plan:change-this-local-password@localhost:15407/plan
PORT=3107
# shared-ai's Ed25519 public key (PEM, one line with \n escapes). Set: the API serves its AI tools at /internal/tools; empty: no tools.
# The server deploy reads it from SSM. @secret @ssm=/sirloinbh/shared/ai-tools-public-key
AI_TOOLS_PUBLIC_KEY=

# Web Push for the evening reminder (#249, #308). Generate the pair once with `npx web-push generate-vapid-keys`
# (not run by the agent). All three set: the reminder works; any empty: it stays off and the API runs as before.
# VAPID_SUBJECT is a mailto: or https:// contact for the push services.
# @secret @ssm=/sirloinbh/plan-routine/vapid-public-key
VAPID_PUBLIC_KEY=
# @secret @ssm=/sirloinbh/plan-routine/vapid-private-key
VAPID_PRIVATE_KEY=
# @secret @ssm=/sirloinbh/plan-routine/vapid-subject
VAPID_SUBJECT=
