{
  "name": "@plan-routine/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file-if-exists=../.env src/migrate.ts",
    "build": "tsc",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "openapi": "tsx src/openapi-cli.ts",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@sirloinbh/auth-client": "1.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "pg": "8.23.1",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sirloinbh/tsconfig": "1.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": true
  }
}
